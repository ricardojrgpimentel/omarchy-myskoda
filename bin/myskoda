#!/usr/bin/env bash
set -euo pipefail

# Read-only client for the official MySkoda Public API.
API_BASE="${MYSKODA_API_BASE:-https://public.api.connect.skoda-auto.cz}"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-myskoda"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy-myskoda"
API_KEY_FILE="$CONFIG_DIR/api-key"
VIN_FILE="$CONFIG_DIR/vin"
LEGACY_REFRESH_FILE="$CONFIG_DIR/refresh-token"
LEGACY_ACCESS_FILE="$CONFIG_DIR/access-token"
LEGACY_LOGIN_FILE="$CONFIG_DIR/login-session.json"
CACHE_FILE="$CACHE_DIR/last-reading.json"
FIXTURE_FILE="${MYSKODA_FIXTURE:-$CONFIG_DIR/fixture.json}"
MAP_UA="omarchy-myskoda/0.2 (read-only desktop widget)"
TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
VIN=""

( umask 077; mkdir -p "$CONFIG_DIR" "$CACHE_DIR/tiles" )
chmod 700 "$CONFIG_DIR" "$CACHE_DIR" "$CACHE_DIR/tiles" 2>/dev/null || true
now() { date +%s; }
write_private() { local p="$1" t="$1.part.$$"; ( umask 077; cat > "$t" ); chmod 600 "$t"; mv -f "$t" "$p"; }
fail_json() { jq -cn --arg e "$1" --arg h "${2:-}" --arg v "${3:-}" '{ok:false,error:$e}+if $h=="" then {} else {hint:$h} end+if $v=="" then {} else {vin:$v} end'; exit 0; }
need() { command -v "$1" >/dev/null 2>&1 || fail_json "missing dependency: $1"; }
for dep in curl jq awk openssl; do need "$dep"; done

api_key() {
  if [ -n "${MYSKODA_API_KEY:-}" ]; then printf '%s' "$MYSKODA_API_KEY"
  elif [ -s "$API_KEY_FILE" ]; then sed -n '1{s/[[:space:]]*$//;p;q;}' "$API_KEY_FILE"; fi
}

configured_vin() {
  if [ -n "$VIN" ]; then printf '%s' "$VIN"
  elif [ -n "${MYSKODA_VIN:-}" ]; then printf '%s' "$MYSKODA_VIN"
  elif [ -s "$VIN_FILE" ]; then sed -n '1{s/[[:space:]]*$//;p;q;}' "$VIN_FILE"; fi
}

validate_vin() {
  [[ $1 =~ ^[[:alnum:]]{17}$ ]] \
    || fail_json "invalid VIN" "Enter the 17-character VIN associated with the API key."
}

header_value() {
  local wanted="$1" file="$2"
  awk -v wanted="$wanted" '
    index($0, ":") > 0 {
      name=substr($0, 1, index($0, ":")-1)
      if (tolower(name)==tolower(wanted)) {
        value=substr($0, index($0, ":")+1)
        sub(/^[[:space:]]+/, "", value)
        sub(/[[:space:]\r]+$/, "", value)
      }
    }
    END { print value }
  ' "$file"
}

request_vehicle() {
  local vin="$1" key="$2" body="$3" headers="$4" temporary="$3.part.$$" status
  if [ -n "${MYSKODA_API_FIXTURE:-}" ]; then
    cp "$MYSKODA_API_FIXTURE" "$body"
    if [ -n "${MYSKODA_API_HEADERS_FIXTURE:-}" ]; then cp "$MYSKODA_API_HEADERS_FIXTURE" "$headers"
    else : > "$headers"; fi
    printf '%s' "${MYSKODA_API_STATUS:-200}"
    return
  fi
  if ! status=$(printf 'X-API-Key: %s\n' "$key" | curl -sS --max-time 45 \
      --header @- --header 'Accept: application/json' --dump-header "$headers" \
      --output "$temporary" --write-out '%{http_code}' \
      "$API_BASE/api/v1/vehicles/$vin?include=info,status,fuelStatus,odometer,parkingPosition,charging" 2>/dev/null); then
    rm -f -- "$temporary"
    return 1
  fi
  mv -f "$temporary" "$body"
  printf '%s' "$status"
}

serve_cache() {
  local error="$1" hint="${2:-}" vin="${3:-}" retry_after="${4:-}"
  if [ -s "$CACHE_FILE" ] && { [ -z "$vin" ] || jq -e --arg vin "$vin" '.vin==$vin' "$CACHE_FILE" >/dev/null 2>&1; }; then
    jq -c --arg e "$error" --arg h "$hint" --arg retry "$retry_after" '
      .+{ok:true,stale:true,error:$e}
      +if $h=="" then {} else {hint:$h} end
      +if $retry=="" then {} else {retry_after:(try ($retry|tonumber) catch $retry)} end
    ' "$CACHE_FILE"
  else fail_json "$error" "$hint" "$vin"; fi
}

normalise_vehicle() {
  local body="$1" headers="$2" vin="$3" expires remaining limit reset
  expires=$(header_value X-API-Key-Expires-At "$headers")
  remaining=$(header_value RateLimit-Remaining "$headers")
  limit=$(header_value RateLimit-Limit "$headers")
  reset=$(header_value RateLimit-Reset "$headers")
  jq -c --argjson at "$(now)" --arg requested_vin "$vin" --arg expires "$expires" \
    --arg remaining "$remaining" --arg limit "$limit" --arg reset "$reset" '
    .vehicle as $v | (.errors//[]) as $errors |
    ($v.status//{}) as $s | ($v.fuelStatus//{}) as $fs | ($v.charging//{}) as $c |
    ($v.parkingPosition//{}) as $p | ($v.odometer//{}) as $o |
    ([$fs.primaryEngineRange,$fs.secondaryEngineRange]
      | map(objects | select(((.engineType//"")|ascii_upcase)=="ELECTRIC")) | first//{}) as $electric |
    ([$fs.primaryEngineRange,$fs.secondaryEngineRange]
      | map(objects | select((((.engineType//"")|ascii_upcase)!="ELECTRIC") and (.engineType!=null))) | first//{}) as $fuel |
    ([$errors[]?.type] | map(select(.!=null))) as $errorTypes |
    (($v.charging!=null) or (($fs.carType//"")=="HYBRID") or any($errorTypes[]?;.=="FUEL_STATUS_UNSUPPORTED")) as $hasElectric |
    (($v.fuelStatus!=null) or any($errorTypes[]?;.=="CHARGING_UNSUPPORTED")) as $hasCombustion |
    (if $hasElectric and $hasCombustion then "hybrid" elif $hasElectric then "electric" elif $hasCombustion then "combustion" else "unknown" end) as $powertrain |
    ($c.status.state//null) as $chargeState |
    ([(if $s.overall.doors=="OPEN" then "one or more doors" else empty end),
      (if $s.overall.windows=="OPEN" then "one or more windows" else empty end),
      (if $s.detail.trunk=="OPEN" then "boot" else empty end),
      (if $s.detail.bonnet=="OPEN" then "bonnet" else empty end),
      (if $s.detail.sunroof=="OPEN" then "sunroof" else empty end)]) as $open |
    ([$s.carCapturedTimestamp,$fs.carCapturedTimestamp,$c.carCapturedTimestamp,
      $p.carCapturedTimestamp,$o.carCapturedTimestamp]|map(select(.!=null))|sort|last//null) as $captured |
    ($errors|map(select((((.type//"")|endswith("_UNSUPPORTED"))|not)))) as $warnings |
    {ok:true,at:$at,captured_at:$captured,vin:($v.vin//$requested_vin),
     name:($v.name//"My Skoda"),model:null,model_year:null,software:null,
     license_plate:($v.licensePlate//null),
     lat:($p.gpsCoordinates.latitude//null),lon:($p.gpsCoordinates.longitude//null),
     address:($p.formattedAddress//null),
     battery:($c.status.battery.stateOfChargeInPercent//$electric.currentSoCInPercent//null),
     fuel:($fuel.currentFuelLevelInPercent//null),
     range_km:($fs.totalRangeInKm//(if $c.status.battery.remainingCruisingRangeInMeters==null then null else ($c.status.battery.remainingCruisingRangeInMeters/1000|round) end)),
     powertrain:$powertrain,
     charging:(($chargeState//"")|ascii_upcase=="CHARGING"),charging_state:$chargeState,
     charge_power_kw:($c.status.chargePowerInKw//null),
     charge_rate_kmh:($c.status.chargingRateInKilometersPerHour//null),
     remaining_minutes:($c.status.remainingTimeToFullyChargedInMinutes//null),
     target_charge:($c.settings.targetStateOfChargeInPercent//null),
     locked:(if ($s.overall.reliableLockStatus//"")=="LOCKED" then true
             elif ($s.overall.reliableLockStatus//"")=="UNLOCKED" then false
             else (($s.overall.locked//"")=="YES") end),
     lock_known:((($s.overall.reliableLockStatus//"")=="LOCKED") or (($s.overall.reliableLockStatus//"")=="UNLOCKED") or (($s.overall.locked//"")=="YES") or (($s.overall.locked//"")=="NO")),
     doors:($s.overall.doors//null),windows:($s.overall.windows//null),lights:($s.overall.lights//null),
     trunk:($s.detail.trunk//null),bonnet:($s.detail.bonnet//null),open:$open,
     odometer_km:($o.mileageInKm//null),partial_errors:[$errors[]?.type],
     api_key_expires_at:(if $expires=="" then null else $expires end),
     rate_limit_remaining:(try ($remaining|tonumber) catch null),
     rate_limit_limit:(try ($limit|tonumber) catch null),
     rate_limit_reset:(try ($reset|tonumber) catch null),
     error:(if ($warnings|length)>0 then "some vehicle data is unavailable" else null end),
     hint:(if ($warnings|length)>0 then ($warnings|map(.description//.type)|join(" ")) else null end)}
  ' "$body"
}

fetch_vehicle() {
  local vin="$1" key="$2" work body headers status problem_type detail retry reading
  work=$(mktemp -d "$CACHE_DIR/read.XXXXXX")
  body="$work/vehicle.json"; headers="$work/headers.txt"
  if ! status=$(request_vehicle "$vin" "$key" "$body" "$headers"); then
    rm -rf -- "$work"
    serve_cache "refresh failed" "Could not reach the MySkoda Public API." "$vin"
    return
  fi
  if [ "$status" = 200 ]; then
    if ! jq -e '.vehicle.vin' "$body" >/dev/null 2>&1; then
      rm -rf -- "$work"
      serve_cache "invalid vehicle response" "The public API returned an unexpected response." "$vin"
      return
    fi
    if ! reading=$(normalise_vehicle "$body" "$headers" "$vin"); then
      rm -rf -- "$work"
      serve_cache "could not understand the vehicle response" "The public API response format may have changed." "$vin"
      return
    fi
    printf '%s\n' "$reading" | write_private "$CACHE_FILE"
    rm -rf -- "$work"
    printf '%s\n' "$reading"
    return
  fi
  problem_type=$(jq -r '.type//empty' "$body" 2>/dev/null || true)
  detail=$(jq -r '.detail//empty' "$body" 2>/dev/null || true)
  retry=$(header_value Retry-After "$headers")
  rm -rf -- "$work"
  case "$status" in
    401) fail_json "API key expired" "Create or update the key in the MySkoda app." "$vin";;
    403) fail_json "API key not authorized" "Check that this VIN was selected when the key was created." "$vin";;
    404) fail_json "vehicle not found" "Check the configured VIN." "$vin";;
    429) serve_cache "rate limit reached" "${detail:-Wait before refreshing again.}" "$vin" "$retry";;
    500|503|504) serve_cache "refresh failed" "${detail:-The MySkoda Public API is temporarily unavailable.}" "$vin";;
    *) fail_json "MySkoda API request failed" "${detail:-HTTP $status${problem_type:+: $problem_type}}";;
  esac
}

cmd_configure() {
  local vin="$1" supplied
  vin=$(printf '%s' "$vin" | tr '[:lower:]' '[:upper:]')
  validate_vin "$vin"
  IFS= read -r supplied || true
  supplied=${supplied%$'\r'}
  [ -n "$supplied" ] || fail_json "empty API key" "Create an API key in the MySkoda app and paste it here."
  printf '%s\n' "$supplied" | write_private "$API_KEY_FILE"
  printf '%s\n' "$vin" | write_private "$VIN_FILE"
  fetch_vehicle "$vin" "$supplied"
}

cmd_connect() {
  local vin="${1:-}" supplied
  if [ -z "$vin" ]; then printf '%s' "VIN: " >&2; IFS= read -r vin; fi
  printf '%s' "Paste MySkoda Public API key: " >&2
  IFS= read -rs supplied; printf '\n' >&2
  printf '%s\n' "$supplied" | cmd_configure "$vin"
}

cmd_logout() {
  rm -f -- "$API_KEY_FILE" "$VIN_FILE" "$LEGACY_REFRESH_FILE" "$LEGACY_ACCESS_FILE" "$LEGACY_LOGIN_FILE"
  jq -cn '{ok:true,configured:false}'
}

cmd_car() {
  local vin key
  if [ -s "$FIXTURE_FILE" ]; then jq -c '.+{ok:true}' "$FIXTURE_FILE"; return; fi
  vin=$(configured_vin)
  [ -n "$vin" ] || fail_json "not configured" "Enter the VIN and an API key created in the MySkoda app."
  vin=$(printf '%s' "$vin" | tr '[:lower:]' '[:upper:]')
  validate_vin "$vin"
  key=$(api_key)
  if [ -z "$key" ] && { [ -s "$LEGACY_REFRESH_FILE" ] || [ -s "$LEGACY_ACCESS_FILE" ]; }; then
    fail_json "Public API key required" "The old login cannot be converted. Create an API key in the MySkoda app." "$vin"
  fi
  [ -n "$key" ] || fail_json "not configured" "Enter the VIN and an API key created in the MySkoda app." "$vin"
  fetch_vehicle "$vin" "$key"
}

cmd_map() {
  local lat="$1" lon="$2" zoom="$3" width="$4" height="$5" plan car_x car_y tiles="[]"
  case "$lat$lon$zoom$width$height" in *[!0-9.\-]*) fail_json "map wants numbers";; esac
  plan=$(awk -v lat="$lat" -v lon="$lon" -v z="$zoom" -v w="$width" -v h="$height" 'BEGIN{pi=3.14159265358979;s=256;n=2^z;r=lat*pi/180;fx=(lon+180)/360*n;fy=(1-log((sin(r)/cos(r))+(1/cos(r)))/pi)/2*n;cx=fx*s;cy=fy*s;l=cx-w/2;t=cy-h/2;x0=int(l/s);if(l<0&&l!=x0*s)x0--;y0=int(t/s);if(t<0&&t!=y0*s)y0--;x1=int((l+w-1)/s);if(l+w-1<0)x1--;y1=int((t+h-1)/s);if(t+h-1<0)y1--;printf "car %d %d\n",int(w/2+.5),int(h/2+.5);for(y=y0;y<=y1;y++)for(x=x0;x<=x1;x++){if(y<0||y>=n)continue;wx=x%n;if(wx<0)wx+=n;printf "tile %d %d %d %d\n",wx,y,int(x*s-l+.5),int(y*s-t+.5)}}')
  car_x=$(printf '%s' "$plan"|awk '/^car/{print $2}'); car_y=$(printf '%s' "$plan"|awk '/^car/{print $3}')
  while read -r _ tx ty px py; do [ -n "${tx:-}" ] || continue; local path; path=$(fetch_tile "$zoom" "$tx" "$ty") || continue; tiles=$(printf '%s' "$tiles"|jq -c --arg p "$path" --argjson x "$px" --argjson y "$py" '.+[{path:$p,x:$x,y:$y}]'); done < <(printf '%s' "$plan"|awk '/^tile/')
  jq -cn --argjson tiles "$tiles" --argjson w "$width" --argjson h "$height" --argjson x "${car_x:-0}" --argjson y "${car_y:-0}" --argjson z "$zoom" '{ok:true,width:$w,height:$h,zoom:$z,tileSize:256,carX:$x,carY:$y,tiles:$tiles,attribution:"© OpenStreetMap contributors"}'
}
fetch_tile() {
  local z="$1" x="$2" y="$3" fp dir path url; fp=$(printf '%s' "$TILE_URL"|openssl dgst -sha256|awk '{print substr($NF,1,10)}'); dir="$CACHE_DIR/tiles/$fp/$z/$x"; path="$dir/$y.png"
  [ -s "$path" ] && { printf '%s' "$path"; return; }; (umask 077; mkdir -p "$dir"); url="${TILE_URL//\{z\}/$z}"; url="${url//\{x\}/$x}"; url="${url//\{y\}/$y}"
  if curl -sS -f --max-time 20 -A "$MAP_UA" -o "$path.part" "$url" 2>/dev/null && [ -s "$path.part" ]; then mv -f "$path.part" "$path"; printf '%s' "$path"; else rm -f -- "$path.part"; return 1; fi
}

usage() { cat <<'EOF'
myskoda: read one Skoda through the official MySkoda Public API.

  configure VIN               read an API key from stdin, save it and validate the VIN
  connect [VIN]               configure interactively in a terminal
  logout                      remove local credentials
  car                         fetch the widget snapshot
  map LAT LON ZOOM WIDTH HEIGHT

Options: --vin VIN, --tile-url URL
Set MYSKODA_API_KEY and MYSKODA_VIN to use credentials from a secret manager.
Set MYSKODA_FIXTURE or create ~/.config/omarchy-myskoda/fixture.json for offline UI testing.
EOF
}
while [ $# -gt 0 ]; do case "$1" in --vin) VIN="${2:-}";shift 2;;--tile-url) TILE_URL="${2:-}";shift 2;;-h|--help)usage;exit 0;;*) command="$1";shift;break;;esac;done
case "${command:-}" in configure)[ $# -eq 1 ]||fail_json "configure needs a VIN";cmd_configure "$1";;connect)[ $# -le 1 ]||fail_json "connect accepts at most one VIN";cmd_connect "${1:-}";;logout)[ $# -eq 0 ]||fail_json "logout takes no arguments";cmd_logout;;car)[ $# -eq 0 ]||fail_json "car takes no arguments";cmd_car;;map)[ $# -eq 5 ]||fail_json "map wants LAT LON ZOOM WIDTH HEIGHT";cmd_map "$@";;*)usage >&2;fail_json "unknown command";;esac
